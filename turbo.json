{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "@bit/contracts#build": {
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "BIT_PASSWORD",
        "BIT_SERVER_URL",
        "HUNT_ROOT",
        "WORKSPACE_ROOT",
        "PORT",
        "HARNESS",
        "HARNESS_INSTANCES",
        "RECONCILE_ON_START",
        "CONTINUATION",
        "CONTINUE_ON_START",
        "PLANNER_ROUND_BUDGET",
        "GOAL_BRIEFING_MAX_CHARS",
        "UPLOAD_MAX_BYTES",
        "UPLOAD_MAX_FILES",
        "UPLOAD_MAX_IMAGE_BYTES",
        "UPLOAD_MAX_TOTAL_BYTES"
      ]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**", ".svelte-kit/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test": {
      "outputs": []
    },
    "test:persistence": {
      "cache": false,
      "outputs": []
    }
  }
}
