{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "@bit/contracts#build": {
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**", ".svelte-kit/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test": {
      "outputs": []
    },
    "test:persistence": {
      "cache": false,
      "outputs": []
    }
  }
}
