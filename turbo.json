{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "@bit/contracts#build": {
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "BIT_PASSWORD",
        "BIT_SERVER_URL",
        "HUNT_ROOT",
        "WORKSPACE_ROOT",
        "PORT",
        "HARNESS",
        "RECONCILE_ON_START"
      ]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**", ".svelte-kit/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test": {
      "outputs": []
    },
    "test:persistence": {
      "cache": false,
      "outputs": []
    }
  }
}
