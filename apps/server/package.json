{
  "name": "@bit/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "build": "bun build src/main.ts --target=bun --packages=external --outdir=dist",
    "start": "bun dist/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun test",
    "test:persistence": "bun test src/persistence src/briefing src/recovery src/run src/mcp/dispatch.test.ts src/policy/install.test.ts"
  },
  "dependencies": {
    "@bit/contracts": "workspace:*",
    "@effect/sql-sqlite-bun": "4.0.5",
    "@opencode/client": "2.1.0",
    "@opencode/schema": "2.1.0",
    "effect": "4.0.5"
  },
  "devDependencies": {
    "@types/bun": "1.4.3"
  }
}
