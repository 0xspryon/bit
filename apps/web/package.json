{
  "name": "@bit/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite --host 127.0.0.1",
    "build": "bun --bun vite build",
    "preview": "bun --bun vite preview --host 127.0.0.1",
    "typecheck": "bun --bun svelte-kit sync && bun --bun svelte-check --tsconfig ./tsconfig.json",
    "test": "bun test && bun run test:dom",
    "test:dom": "bun --conditions=browser test --config=bunfig.dom.toml test/dom"
  },
  "dependencies": {
    "@bit/contracts": "workspace:*",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "effect": "4.0.5",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "21.0.4",
    "@poppanator/sveltekit-svg": "7.0.1",
    "@sveltejs/adapter-static": "4.0.0",
    "@sveltejs/kit": "3.1.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/bun": "1.4.3",
    "@types/hast": "3.0.5",
    "line-awesome": "2.0.1",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "vite": "8.3.4"
  }
}
